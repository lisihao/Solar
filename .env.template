# Solar 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# 命令: cp .env.template .env

# ========================================
# Anthropic (Claude) API
# ========================================
# Required: yes
# 引用方: ~/.solar/bin/brain-router, ~/Solar/core/llm/anthropic.ts
# 用途: Claude API 调用（核心依赖）
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ========================================
# Zhipu AI (智谱) API
# ========================================
# Required: yes
# 引用方: ~/.solar/bin/brain-router, ~/Solar/core/llm/zhipu.ts
# 用途: GLM 模型调用
ZHIPU_API_KEY=your_zhipu_api_key_here

# ========================================
# DeepSeek API
# ========================================
# Required: yes
# 引用方: ~/.solar/bin/brain-router, ~/Solar/core/llm/deepseek.ts
# 用途: DeepSeek 模型调用
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ========================================
# Google API
# ========================================
# Required: yes (for Gmail/Calendar/Drive OAuth)
# 引用方: ~/.claude/hooks/gmail-auth.sh, ~/.claude/hooks/google-auth.sh
# 用途: Google 服务 OAuth 认证
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret_here

# ========================================
# OpenAI API
# ========================================
# Required: no (备用模型)
# 引用方: ~/.solar/bin/brain-router (备用)
# 用途: GPT 模型调用（可选）
OPENAI_API_KEY=your_openai_api_key_here

# ========================================
# Tavily Search API
# ========================================
# Required: no
# 引用方: WebSearch MCP (~/.claude/skills/gstack/browse)
# 用途: 网页搜索增强
TAVILY_API_KEY=your_tavily_api_key_here

# ========================================
# Solar Harness 配置
# ========================================
# Required: no
# 引用方: coordinator.sh
# 用途: 协调器日志级别
SOLAR_LOG_LEVEL=info

# Required: no
# 引用方: coordinator.sh
# 用途: 协调器循环间隔（秒）
SOLAR_COORDINATOR_TICK_SECONDS=3

# Required: no
# 引用方: coordinator.sh
# 用途: 最大并发 Sprint 数
SOLAR_MAX_CONCURRENT_SPRINTS=5

# ========================================
# 路径配置
# ========================================
# Required: no (自动检测)
# 引用方: 多个脚本
# 用途: Solar 主目录
SOLAR_HOME=$HOME/.solar

# Required: no (自动检测)
# 引用方: 多个脚本
# 用途: Claude 配置目录
CLAUDE_HOME=$HOME/.claude

# Required: no (自动检测)
# 引用方: 多个脚本
# 用途: Solar 项目根目录
SOLAR_PROJECT_ROOT=$HOME/Solar

# ========================================
# 网络配置
# ========================================
# Required: no
# 引用方: ~/.solar/bin/solar-remote-run
# 用途: Mac mini 远程主机（SSH）
SOLAR_REMOTE_HOST=lisihao@100.122.223.55

# Required: no
# 引用方: ~/.solar/bin/solar-remote-run
# 用途: Mac mini VNC 端口
SOLAR_REMOTE_VNC_PORT=5900

# ========================================
# 开发调试
# ========================================
# Required: no
# 引用方: coordinator.sh
# 用途: 启用调试模式（verbose 日志）
SOLAR_DEBUG=false

# Required: no
# 引用方: ~/.solar/bin/solar-harness
# 用途: 测试模式（不真实执行）
SOLAR_TEST_MODE=false
