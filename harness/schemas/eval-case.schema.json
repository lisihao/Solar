{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "eval-case.schema.json",
  "title": "EvalCase",
  "description": "A single evaluation case for the Requirement Compiler dataset.",
  "type": "object",
  "required": ["case_id", "sprint_id", "split", "source_type"],
  "properties": {
    "case_id": {
      "type": "string",
      "description": "Unique identifier for this evaluation case (usually sprint_id)."
    },
    "sprint_id": {
      "type": "string",
      "description": "The sprint this case was derived from."
    },
    "split": {
      "type": "string",
      "enum": ["trainset", "valset", "hard_cases"],
      "description": "Which dataset split this case belongs to."
    },
    "source_type": {
      "type": "string",
      "enum": ["artifact", "accepted_md_fallback"],
      "description": "Whether data came from real artifacts or accepted.md heuristic."
    },
    "requirement_ir": {
      "type": ["object", "null"],
      "description": "Requirement IR artifact (JSON)."
    },
    "contracts": {
      "type": ["array", "null"],
      "items": {"type": "object"},
      "description": "Contract artifacts (YAML/JSON)."
    },
    "task_dag": {
      "type": ["object", "null"],
      "description": "Task DAG artifact (task_graph.json)."
    },
    "task_state": {
      "type": ["object", "null"],
      "description": "Task state artifact."
    },
    "task_closure": {
      "type": ["object", "null"],
      "description": "Task closure artifact."
    },
    "acceptance_verdict": {
      "type": ["object", "null"],
      "description": "Acceptance verdict artifact."
    },
    "coverage_report": {
      "type": ["object", "null"],
      "description": "Coverage report artifact."
    },
    "traces": {
      "type": ["object", "null"],
      "description": "Planner/builder/evaluator execution traces."
    },
    "handoff": {
      "type": ["object", "null"],
      "description": "Handoff artifact."
    },
    "eval": {
      "type": ["object", "null"],
      "description": "Evaluation artifact."
    },
    "input_text": {
      "type": "string",
      "description": "Requirement text (fallback-only)."
    },
    "expected_ir": {
      "type": ["object", "null"],
      "description": "Expected IR (fallback-only)."
    },
    "expected_contracts": {
      "type": ["array", "null"],
      "items": {"type": "object"},
      "description": "Expected contracts (fallback-only)."
    },
    "expected_dag": {
      "type": ["object", "null"],
      "description": "Expected DAG (fallback-only)."
    },
    "hard_case_categories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "mixed_request",
          "research_to_build",
          "approval_high_risk",
          "evidence_heavy",
          "trace_complexity"
        ]
      },
      "description": "Categories for hard cases."
    },
    "source_path": {
      "type": "string",
      "description": "Filesystem path where this case was loaded from."
    }
  },
  "additionalProperties": false
}
