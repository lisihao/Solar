{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/attempt-ledger.schema.json",
  "title": "Solar Attempt Ledger Record",
  "description": "Append-only record for evolution/meta attempts. Evidence remains in evidence ledger and is referenced by id/path.",
  "type": "object",
  "required": [
    "schema_version",
    "attempt_id",
    "run_id",
    "mode",
    "status",
    "created_at",
    "candidate_artifact",
    "score"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "solar.attempt_ledger.v1"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "execution",
        "evolution",
        "meta"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "evaluating",
        "passed",
        "failed",
        "timeout",
        "pruned",
        "accepted",
        "rejected",
        "interrupted",
        "eval_lost"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "closed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "parent_attempt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "children": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lineage_depth": {
          "type": "integer",
          "minimum": 0
        },
        "root_attempt_id": {
          "type": "string"
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "mutation_ops": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "agent_id": {
      "type": "string"
    },
    "operator_id": {
      "type": "string"
    },
    "capsule_id": {
      "type": "string"
    },
    "logical_node": {
      "type": "string"
    },
    "commit_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "candidate_artifact": {
      "type": "string",
      "minLength": 1
    },
    "candidate_patch_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_family": {
      "type": "string"
    },
    "score": {
      "type": "object",
      "required": [
        "primary",
        "metrics"
      ],
      "additionalProperties": false,
      "properties": {
        "primary": {
          "type": "number"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "pareto_rank": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "asi_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "public_feedback": {
      "type": "string"
    },
    "private_feedback_ref": {
      "type": [
        "string",
        "null"
      ],
      "description": "Evaluator-private feedback location. Do not inline private grader details."
    },
    "failure_mode": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "public_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "shared_memory_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "resource_constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quota_pool": {
          "type": "string"
        },
        "access_path": {
          "type": "string"
        },
        "model_profile": {
          "type": "string"
        },
        "evaluator_concurrency_key": {
          "type": "string"
        },
        "max_wall_time_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "diversity_vector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string"
        },
        "access_path": {
          "type": "string"
        },
        "cost_band": {
          "type": "string"
        },
        "strategy": {
          "type": "string"
        },
        "is_exploit": {
          "type": "boolean"
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "daemon_id": {
          "type": "string"
        },
        "plan_ref": {
          "type": "string"
        },
        "isolation_mode": {
          "type": "string",
          "enum": [
            "isolated_worktree",
            "sandbox",
            "read_only_replay"
          ]
        },
        "private_feedback_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "compat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_dispatch_id": {
          "type": "string"
        },
        "legacy_attempt_key": {
          "type": "string"
        },
        "legacy_status": {
          "type": "string"
        }
      }
    }
  }
}
