{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/traceability.schema.json",
  "title": "Solar Traceability Matrix",
  "type": "object",
  "required": [
    "schema_version",
    "trace_id",
    "sprint_id",
    "request_ir",
    "contract_manifest",
    "task_graph",
    "dispatch_packages",
    "updated_at"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "solar.traceability.v1"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "sprint_id": {
      "type": "string",
      "minLength": 1
    },
    "request_ir": {
      "type": "string",
      "minLength": 1
    },
    "contract_manifest": {
      "type": "string",
      "minLength": 1
    },
    "task_graph": {
      "type": "string",
      "minLength": 1
    },
    "dispatch_packages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "updated_at": {
      "type": "string"
    }
  }
}
