{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dataset.schema.json",
  "title": "DatasetManifest",
  "description": "Metadata about a loaded dataset split.",
  "type": "object",
  "required": ["split", "case_count", "artifact_sourced_count", "fallback_sourced_count"],
  "properties": {
    "split": {
      "type": "string",
      "enum": ["trainset", "valset", "hard_cases"]
    },
    "case_count": {
      "type": "integer",
      "minimum": 0
    },
    "artifact_sourced_count": {
      "type": "integer",
      "minimum": 0
    },
    "fallback_sourced_count": {
      "type": "integer",
      "minimum": 0
    },
    "hard_case_categories_covered": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "mixed_request",
          "research_to_build",
          "approval_high_risk",
          "evidence_heavy",
          "trace_complexity"
        ]
      }
    }
  },
  "additionalProperties": false
}
