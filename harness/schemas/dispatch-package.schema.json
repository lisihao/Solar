{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/dispatch-package.schema.json",
  "title": "Solar Dispatch Package",
  "type": "object",
  "required": [
    "schema_version",
    "dispatch_id",
    "sprint_id",
    "node_id",
    "digest",
    "dispatch_md_path",
    "created_at",
    "issued_by",
    "payload"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "solar.dispatch_package.v1"
    },
    "dispatch_id": {
      "type": "string",
      "minLength": 1
    },
    "sprint_id": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "minLength": 1
    },
    "dispatch_md_path": {
      "type": "string",
      "minLength": 1
    },
    "dispatch_json_path": {
      "type": "string",
      "minLength": 1
    },
    "issued_by": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "description": "Machine-readable evidence references produced by the worker for this dispatch. Each entry links to a concrete artifact, command result, or event in the harness run_dir.",
      "items": {
        "type": "object",
        "required": ["type", "ref"],
        "additionalProperties": true,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["artifact_path", "event_id", "action_id", "command_result", "run_dir_file"]
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "description": "The concrete reference: file path, event UUID, action ID, or command string."
          },
          "description": {
            "type": "string",
            "description": "Human-readable description of what this evidence ref proves."
          },
          "timestamp": {
            "type": "string",
            "description": "ISO-8601 timestamp when this evidence was collected."
          }
        }
      }
    },
    "evidence_status": {
      "type": "string",
      "description": "Explicit completion evidence status declared by the worker. When present, validators accept this as a machine-readable signal instead of requiring natural-language claim parsing.",
      "enum": ["complete", "partial", "incomplete", "not_applicable"]
    },
    "payload": {
      "type": "object",
      "required": [
        "content",
        "schema_version"
      ],
      "additionalProperties": true,
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "object",
          "additionalProperties": true
        },
        "apo_artifacts": {
          "type": "object",
          "additionalProperties": true,
          "description": "APO execution plan artifacts from compile_execution_plan_for_node()",
          "properties": {
            "task_classification": {
              "type": "object",
              "additionalProperties": true
            },
            "logical_workflow": {
              "type": "object",
              "additionalProperties": true
            },
            "skill_plan": {
              "type": "object",
              "additionalProperties": true
            },
            "mcp_plan": {
              "type": "object",
              "additionalProperties": true
            },
            "capsule_plan_artifact": {
              "type": "object",
              "additionalProperties": true
            },
            "physical_plan_artifact": {
              "type": "object",
              "additionalProperties": true
            },
            "selection_rationale": {
              "type": ["object", "string"],
              "additionalProperties": true
            },
            "evidence_policy": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    }
  }
}
