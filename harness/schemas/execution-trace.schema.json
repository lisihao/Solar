{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/execution-trace.schema.json",
  "title": "Solar Execution Trace",
  "description": "Normalized projection over dispatch, lease, ack, hygiene, verifier, evidence, cost, and scheduler records. Backward-compatible raw payloads live under legacy.",
  "type": "object",
  "required": [
    "schema_version",
    "trace_id",
    "dispatch_id",
    "run_id",
    "sprint_id",
    "task_type",
    "logical_operator",
    "capsule_id",
    "operator_id",
    "surface",
    "created_at",
    "dispatch",
    "lease",
    "ack"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "solar.execution_trace.v1"
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "dispatch_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "sprint_id": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "logical_operator": {
      "type": "string"
    },
    "logical_node": {
      "type": "string"
    },
    "capsule_id": {
      "type": "string"
    },
    "operator_id": {
      "type": "string"
    },
    "surface": {
      "type": "string",
      "enum": [
        "tui",
        "headless",
        "local",
        "browser",
        "mcp"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "dispatch": {
      "$ref": "#/$defs/dispatch"
    },
    "lease": {
      "$ref": "#/$defs/lease"
    },
    "ack": {
      "$ref": "#/$defs/ack"
    },
    "hygiene": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/timed_state"
      },
      "default": []
    },
    "verifier": {
      "$ref": "#/$defs/verifier"
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "cost": {
      "$ref": "#/$defs/cost"
    },
    "timeline": {
      "$ref": "#/$defs/timeline"
    },
    "scheduler_context": {
      "$ref": "#/$defs/scheduler_context"
    },
    "asi": {
      "$ref": "#/$defs/asi"
    },
    "data_quality": {
      "$ref": "#/$defs/data_quality"
    },
    "legacy": {
      "type": "object",
      "description": "Backward-compatible container for current dispatch/lease/ack/evidence payloads.",
      "additionalProperties": true
    },
    "compat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dispatch_status": {
          "type": "string"
        },
        "dispatch_task_id": {
          "type": "string"
        },
        "lease_status": {
          "type": "string"
        },
        "ack_status": {
          "type": "string"
        },
        "verifier_status": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "dispatch": {
      "type": "object",
      "required": [
        "dispatch_status",
        "dispatch_ts",
        "dispatch_file"
      ],
      "additionalProperties": false,
      "properties": {
        "dispatch_status": {
          "type": "string"
        },
        "dispatch_ts": {
          "type": "string",
          "format": "date-time"
        },
        "dispatch_file": {
          "type": "string"
        },
        "dispatch_payload_ref": {
          "type": "string"
        },
        "fallback_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "lease": {
      "type": "object",
      "required": [
        "lease_id",
        "lease_state",
        "timeline"
      ],
      "additionalProperties": false,
      "properties": {
        "lease_id": {
          "type": "string"
        },
        "lease_state": {
          "type": "string"
        },
        "ttl_ms": {
          "type": "integer",
          "minimum": 1
        },
        "acquired_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "release_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "lease_ttl_policy": {
          "type": [
            "string",
            "null"
          ]
        },
        "timeline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/timed_state"
          }
        }
      }
    },
    "ack": {
      "type": "object",
      "required": [
        "ack_status",
        "timeline"
      ],
      "additionalProperties": false,
      "properties": {
        "ack_status": {
          "type": "string"
        },
        "ack_ts": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "ack_wait_ms": {
          "type": "number",
          "minimum": 0
        },
        "ack_timeout_ms": {
          "type": "number",
          "minimum": 0
        },
        "ack_timeout": {
          "type": "boolean",
          "default": false
        },
        "timeline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/timed_state"
          }
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "WARNING",
            "PENDING"
          ]
        },
        "verifier_actor_id": {
          "type": "string"
        },
        "verifier_ts": {
          "type": "string",
          "format": "date-time"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "failure_mode": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "patch_scope": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "evidence_completeness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "operator_trace_summary": {
          "type": "string"
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact_ref"
          },
          "default": []
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quota_pool": {
          "type": "string"
        },
        "quota_used": {
          "type": "number",
          "minimum": 0
        },
        "cost_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "dispatch_to_lease_ms": {
          "type": "integer",
          "minimum": 0
        },
        "lease_to_run_ms": {
          "type": "integer",
          "minimum": 0
        },
        "run_to_ack_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "scheduler_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "execution",
            "evolution",
            "meta"
          ]
        },
        "scheduler_id": {
          "type": "string"
        },
        "decision_id": {
          "type": "string"
        },
        "rejected_candidates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "asi": {
      "type": "object",
      "description": "Actionable Side Information for evaluator and optimizer consumption.",
      "additionalProperties": false,
      "properties": {
        "success_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "verifier_pass": {
          "type": "boolean"
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "premium_quota_burn": {
          "type": "number",
          "minimum": 0
        },
        "ack_timeout_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stuck_pane_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "patch_scope_accuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_completeness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "security_events": {
          "type": "integer",
          "minimum": 0
        },
        "context_pollution_probability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0
        },
        "failure_mode": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "missing_sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "projection_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "timed_state": {
      "type": "object",
      "required": [
        "ts",
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "state": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "artifact_ref": {
      "type": "object",
      "required": [
        "kind",
        "path",
        "ts"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
