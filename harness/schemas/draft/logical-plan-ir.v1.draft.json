{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/draft/logical-plan-ir.v1.draft.json",
  "title": "Solar LogicalPlanIR v1",
  "description": "LogicalPlanIR is the second compile layer. It defines a DAG of workflow-native logical operators with dependencies, input/output contracts, and verifier requirements. Links upstream to TaskIR via task_ir_id.",
  "type": "object",
  "required": ["schema_version", "logical_plan_id", "task_ir_id", "nodes"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "string", "const": "solar.logical_plan_ir.v1"},
    "logical_plan_id": {"type": "string", "minLength": 1},
    "task_ir_id": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "logical_operator", "depends_on"],
        "additionalProperties": true,
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "logical_operator": {
            "type": "string",
            "enum": [
              "ScanContext", "DebugRCA", "DesignSolution", "ImplementPatch",
              "RunTests", "RunBenchmark", "ReviewPatch", "SynthesizeReport",
              "VerifyClaim", "AskHuman", "CompressContext"
            ]
          },
          "compat_operator": {"type": "string"},
          "goal": {"type": "string"},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "input_contract": {"type": "object", "additionalProperties": true},
          "output_contract": {"type": "object", "additionalProperties": true},
          "verifier_required": {"type": "boolean"},
          "acceptance": {"type": "array", "items": {"type": "string"}},
          "parallelism_hint": {"type": "string", "enum": ["sequential", "parallel", "join"]},
          "fallback": {"type": "string"}
        }
      },
      "minItems": 1
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "additionalProperties": true,
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "label": {"type": "string"}
        }
      }
    },
    "required_gates": {"type": "array", "items": {"type": "string"}},
    "provenance": {"$ref": "https://solar.local/schemas/draft/effect-ir.v1.draft.json#/definitions/provenance"}
  }
}
