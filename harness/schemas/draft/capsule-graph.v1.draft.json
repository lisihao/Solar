{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/draft/capsule-graph.v1.draft.json",
  "title": "Solar CapsuleGraph v1 Draft",
  "type": "object",
  "required": ["schema_version", "original_capsule_plan_node", "nodes", "edges"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "solar.capsule_graph.v1"},
    "original_capsule_plan_node": {"type": "object"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "stage_kind", "capability_capsule_id"],
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "edge_id",
          "from_node_id",
          "to_node_id",
          "artifact_type",
          "proof_status",
          "taint_labels",
          "uncertainty_score",
          "composition_contract_ref",
          "required_guarantees"
        ],
        "additionalProperties": true,
        "properties": {
          "edge_id": {"type": "string", "minLength": 1},
          "from_node_id": {"type": "string", "minLength": 1},
          "to_node_id": {"type": "string", "minLength": 1},
          "artifact_type": {"type": "string", "minLength": 1},
          "proof_status": {
            "type": "string",
            "enum": ["not_required", "pending", "passed", "failed", "unknown"]
          },
          "taint_labels": {"type": "array", "items": {"type": "string"}},
          "uncertainty_score": {"type": "number", "minimum": 0, "maximum": 1},
          "composition_contract_ref": {"type": ["string", "null"]},
          "required_guarantees": {"type": "array", "items": {"type": "string"}},
          "why_rejected": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
