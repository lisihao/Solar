{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/draft/evidence-ir.v1.draft.json",
  "title": "Solar Evidence IR v1",
  "description": "Evidence IR records claims, supporting evidence, artifacts, approvals, spec references, tests run, and verifier decisions.",
  "type": "object",
  "required": ["schema_version", "evidence_id", "claims"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "string", "const": "solar.evidence_ir.v1"},
    "evidence_id": {"type": "string", "minLength": 1},
    "spec_ref": {"type": "string"},
    "capsule_ref": {"type": "string"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "text"],
        "additionalProperties": true,
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "kind": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "falsifiable": {"type": "boolean"}
        }
      },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "kind", "artifact_path"],
        "additionalProperties": true,
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string"},
          "artifact_path": {"type": "string"},
          "verified": {"type": "boolean"}
        }
      }
    },
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "approvals": {"type": "array", "items": {"type": "string"}},
    "tests_run": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "exit_code"],
        "additionalProperties": true,
        "properties": {
          "command": {"type": "string"},
          "exit_code": {"type": "integer"},
          "output_summary": {"type": "string"}
        }
      }
    },
    "verifier_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["verifier_id", "verdict"],
        "additionalProperties": true,
        "properties": {
          "verifier_id": {"type": "string"},
          "verdict": {"type": "string", "enum": ["PASS", "FAIL", "SKIP"]},
          "reason": {"type": "string"}
        }
      }
    },
    "provenance": {"$ref": "https://solar.local/schemas/draft/effect-ir.v1.draft.json#/definitions/provenance"}
  }
}
