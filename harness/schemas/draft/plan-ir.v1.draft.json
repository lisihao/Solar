{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/draft/plan-ir.v1.draft.json",
  "title": "Solar Plan IR v1",
  "description": "Plan IR defines a DAG of logical operators with dependencies, parallelism hints, and fallback strategies.",
  "type": "object",
  "required": ["schema_version", "plan_id", "nodes"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "string", "const": "solar.plan_ir.v1"},
    "plan_id": {"type": "string", "minLength": 1},
    "spec_ref": {"type": "string"},
    "dag_variant": {"type": "string"},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "logical_operator", "depends_on"],
        "additionalProperties": true,
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "logical_operator": {"type": "string", "minLength": 1},
          "goal": {"type": "string"},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "parallelism_hint": {"type": "string", "enum": ["sequential", "parallel", "join"]},
          "fallback": {"type": "string"},
          "acceptance": {"type": "array", "items": {"type": "string"}}
        }
      },
      "minItems": 1
    },
    "required_gates": {"type": "array", "items": {"type": "string"}},
    "provenance": {"$ref": "https://solar.local/schemas/draft/effect-ir.v1.draft.json#/definitions/provenance"}
  }
}
