{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/draft/capsule-plan-ir.v1.draft.json",
  "title": "Solar CapsulePlanIR v1",
  "description": "CapsulePlanIR is the third compile layer. It maps each logical node to a capability/guard/resource/verifier/workflow capsule with effect models, policy contracts, composition rules, and candidate ranking. Links upstream to LogicalPlanIR via logical_plan_id.",
  "type": "object",
  "required": ["schema_version", "capsule_plan_id", "logical_plan_id", "nodes"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "string", "const": "solar.capsule_plan_ir.v1"},
    "capsule_plan_id": {"type": "string", "minLength": 1},
    "logical_plan_id": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "selected_capsule_id", "capsule_kind"],
        "additionalProperties": true,
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "selected_capsule_id": {"type": "string", "minLength": 1},
          "capsule_kind": {
            "type": "string",
            "enum": ["capability", "guard", "resource", "verifier", "workflow"]
          },
          "candidate_capsules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["capsule_id"],
              "additionalProperties": true,
              "properties": {
                "capsule_id": {"type": "string"},
                "match_reason": {"type": "string"},
                "rejection_reason": {"type": "string"},
                "rank": {"type": "integer"}
              }
            }
          },
          "input_contract": {"type": "object", "additionalProperties": true},
          "output_contract": {"type": "object", "additionalProperties": true},
          "effect_model": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "read": {"type": "array", "items": {"type": "string"}},
              "write": {"type": "array", "items": {"type": "string"}},
              "shell": {"type": "array", "items": {"type": "string"}},
              "network": {"type": "array", "items": {"type": "string"}},
              "secret": {"type": "array", "items": {"type": "string"}},
              "verify": {"type": "array", "items": {"type": "string"}},
              "evidence": {"type": "array", "items": {"type": "string"}}
            }
          },
          "policy_contract": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "safety": {"type": "array", "items": {"type": "string"}},
              "compliance": {"type": "array", "items": {"type": "string"}}
            }
          },
          "composition": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "requires_before": {"type": "array", "items": {"type": "string"}},
              "requires_after": {"type": "array", "items": {"type": "string"}},
              "incompatible_with": {"type": "array", "items": {"type": "string"}}
            }
          },
          "required_operator_traits": {"type": "array", "items": {"type": "string"}},
          "required_skills": {"type": "array", "items": {"type": "string"}},
          "mcp_requirements": {
            "type": "object",
            "additionalProperties": {"type": "array", "items": {"type": "string"}}
          },
          "verifier_requirements": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "independent_actor_required": {"type": "boolean"},
              "verifier_capsule_id": {"type": "string"}
            }
          },
          "explain": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "why_selected": {"type": "string"},
              "why_rejected": {"type": "array", "items": {"type": "string"}},
              "compat_fallback": {"type": "boolean"}
            }
          }
        }
      },
      "minItems": 1
    },
    "provenance": {"$ref": "https://solar.local/schemas/draft/effect-ir.v1.draft.json#/definitions/provenance"}
  }
}
