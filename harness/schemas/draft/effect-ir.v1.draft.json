{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/draft/effect-ir.v1.draft.json",
  "title": "Solar Effect IR v1",
  "description": "Effect IR declares action type, permissions, reversibility, idempotency, and approval rules for side effects.",
  "type": "object",
  "required": ["schema_version", "effect_id", "action_type"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "string", "const": "solar.effect_ir.v1"},
    "effect_id": {"type": "string", "minLength": 1},
    "action_type": {"type": "string", "enum": ["read", "write", "execute", "network", "cost", "risk"]},
    "permissions": {"type": "array", "items": {"type": "string"}},
    "reversibility": {"type": "string", "enum": ["reversible", "irreversible", "compensating"]},
    "idempotency": {"type": "string", "enum": ["idempotent", "non_idempotent", "at_most_once"]},
    "approval_rules": {"type": "array", "items": {"type": "string"}},
    "targets": {"type": "array", "items": {"type": "string"}},
    "capsule_ref": {"type": "string"},
    "provenance": {
      "type": "object",
      "description": "Shared provenance definition referenced by other IR schemas.",
      "additionalProperties": true,
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "created_at": {"type": "string"},
        "source_ref": {"type": "string"}
      }
    }
  },
  "definitions": {
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "created_at": {"type": "string"},
        "source_ref": {"type": "string"}
      }
    }
  }
}
