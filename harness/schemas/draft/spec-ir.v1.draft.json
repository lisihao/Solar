{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/draft/spec-ir.v1.draft.json",
  "title": "Solar Spec IR v1",
  "description": "Spec IR defines scope boundaries: allowed actions, forbidden actions, success conditions, evidence requirements, approvals, and rollback strategy.",
  "type": "object",
  "required": ["schema_version", "spec_id", "scope"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "string", "const": "solar.spec_ir.v1"},
    "spec_id": {"type": "string", "minLength": 1},
    "intent_ref": {"type": "string"},
    "scope": {
      "type": "object",
      "required": ["allowed", "forbidden", "success"],
      "additionalProperties": true,
      "properties": {
        "allowed": {"type": "array", "items": {"type": "string"}},
        "forbidden": {"type": "array", "items": {"type": "string"}},
        "success": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "evidence_required": {"type": "array", "items": {"type": "string"}},
        "approvals": {"type": "array", "items": {"type": "string"}},
        "rollback": {"type": "string"}
      }
    },
    "provenance": {"$ref": "https://solar.local/schemas/draft/effect-ir.v1.draft.json#/definitions/provenance"}
  }
}
