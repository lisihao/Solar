{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/draft/capsule-runtime-contract.v1.draft.json",
  "title": "Solar Capsule Runtime Contract v1 Draft",
  "description": "Additive runtime contract for capsule-native core runtime. Legacy capability/guard/resource manifests are mapped into capsule_type during read normalization.",
  "type": "object",
  "required": [
    "capability_capsule_id",
    "capsule_type",
    "effect_union",
    "proof_obligations",
    "composition_contract",
    "policy_ref",
    "resource_budget"
  ],
  "additionalProperties": true,
  "properties": {
    "capability_capsule_id": {"type": "string", "minLength": 1},
    "execution_capsule_id": {"type": "string", "minLength": 1},
    "capsule_kind": {"type": "string", "enum": ["capability", "guard", "resource"]},
    "capsule_type": {
      "type": "string",
      "enum": ["primitive", "composite", "workflow", "verifier", "adapter", "policy"]
    },
    "effect_union": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read": {"type": "array", "items": {"type": "string"}},
        "write": {"type": "array", "items": {"type": "string"}},
        "execute": {"type": "array", "items": {"type": "string"}},
        "network": {"type": "array", "items": {"type": "string"}},
        "cost": {"type": "array", "items": {"type": "string"}},
        "risk": {"type": "array", "items": {"type": "string"}}
      }
    },
    "proof_obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "source_capsule_id", "requirement"],
        "additionalProperties": true,
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "source_capsule_id": {"type": "string", "minLength": 1},
          "requirement": {"type": "string", "minLength": 1}
        }
      }
    },
    "composition_contract": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "consumes": {"type": "array"},
        "produces": {"type": "array"},
        "compatible_with": {"type": "array", "items": {"type": "string"}},
        "incompatible_with": {"type": "array", "items": {"type": "string"}},
        "requires_after": {"type": "array", "items": {"type": "string"}}
      }
    },
    "policy_ref": {
      "type": ["object", "string", "null"],
      "additionalProperties": true
    },
    "operator_adapter_id": {"type": ["string", "null"]},
    "resource_budget": {
      "type": "object",
      "additionalProperties": true
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "legacy_execution_capsule_id": {"type": "string"},
        "legacy_capsule_kind": {"type": "string"}
      }
    }
  }
}
