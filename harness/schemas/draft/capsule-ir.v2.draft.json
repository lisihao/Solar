{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/draft/capsule-ir.v2.draft.json",
  "title": "Solar Capsule IR v2",
  "description": "Capsule IR v2 extends v1 capability-capsule with type_signature, composition_contract, and IR-native fields. Backward-compatible with v1 capsule JSON.",
  "type": "object",
  "required": ["schema_version", "capsule_ir_id", "type_signature", "contract", "effects", "composition"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "string", "enum": ["solar.capsule_ir.v2", "solar.capsule_ir.v1"]},
    "capsule_ir_id": {"type": "string", "minLength": 1},
    "type_signature": {
      "type": "object",
      "required": ["inputs", "outputs"],
      "additionalProperties": true,
      "properties": {
        "inputs": {"type": "array", "items": {"type": "object"}},
        "outputs": {"type": "array", "items": {"type": "object"}}
      }
    },
    "contract": {
      "type": "object",
      "required": ["preconditions", "postconditions"],
      "additionalProperties": true,
      "properties": {
        "preconditions": {"type": "array", "items": {"type": "object"}},
        "postconditions": {"type": "array", "items": {"type": "object"}},
        "invariants": {"type": "array", "items": {"type": "string"}}
      }
    },
    "effects": {
      "type": "object",
      "required": ["read", "write", "execute", "network", "cost", "risk"],
      "additionalProperties": true,
      "properties": {
        "read": {"type": "array", "items": {"type": "string"}},
        "write": {"type": "array", "items": {"type": "string"}},
        "execute": {"type": "array", "items": {"type": "string"}},
        "network": {"type": "array", "items": {"type": "string"}},
        "cost": {"type": "array", "items": {"type": "string"}},
        "risk": {"type": "array", "items": {"type": "string"}}
      }
    },
    "composition": {
      "type": "object",
      "required": ["consumes", "produces"],
      "additionalProperties": true,
      "properties": {
        "consumes": {"type": "array", "items": {"type": "object"}},
        "produces": {"type": "array", "items": {"type": "object"}},
        "compatible_with": {"type": "array", "items": {"type": "string"}},
        "incompatible_with": {"type": "array", "items": {"type": "string"}}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {"type": "string"},
        "description": {"type": "string"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "self_check": {"type": "array", "items": {"type": "string"}},
        "pass_conditions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "skills": {"type": "object", "additionalProperties": true},
        "mcp_capabilities": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
        "data_refs": {"type": "array", "items": {"type": "string"}},
        "secret_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "provenance": {"$ref": "https://solar.local/schemas/draft/effect-ir.v1.draft.json#/definitions/provenance"},
    "v1_compat": {
      "type": "object",
      "description": "Fields preserved from v1 capability-capsule for backward compatibility.",
      "additionalProperties": true,
      "properties": {
        "capability_capsule_id": {"type": "string"},
        "capsule_kind": {"type": "string", "enum": ["capability", "guard", "resource"]},
        "applicability": {"type": "object", "additionalProperties": true},
        "operator_compatibility": {"type": "object", "additionalProperties": true}
      }
    }
  }
}
