{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/draft/physical-plan-ir.v2.draft.json",
  "title": "Solar Physical Plan IR v2",
  "description": "Physical execution plan binding resources, access paths, quota, policy and placement to a DAG node.",
  "type": "object",
  "required": ["ir_id", "ir_type", "schema_version", "node_id", "plan_valid"],
  "additionalProperties": true,
  "properties": {
    "ir_id": {"type": "string", "minLength": 1},
    "ir_type": {"type": "string", "const": "physical_plan"},
    "schema_version": {"type": "string", "const": "2"},
    "node_id": {"type": "string"},
    "logical_operator": {"type": "string"},
    "capability_capsule_id": {"type": ["string", "null"]},
    "dispatch_task_type": {"type": ["string", "null"]},
    "artifact_types": {"type": "object", "additionalProperties": true},
    "effect_union": {"type": "object", "additionalProperties": true},
    "proof_obligations": {"type": "array", "items": {"type": "string"}},
    "selected_operator_id": {"type": "string"},
    "execution_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["operator_id"],
        "properties": {
          "operator_id": {"type": "string"},
          "provider": {"type": "string"},
          "estimated_cost": {"type": "string"},
          "priority": {"type": "integer"},
          "constraints": {"type": "object"}
        }
      }
    },
    "attached_capsules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage_id", "stage_kind", "capability_capsule_id"],
        "properties": {
          "stage_id": {"type": "string"},
          "stage_kind": {"type": "string"},
          "capability_capsule_id": {"type": "string"},
          "dispatch_mode": {"type": "string"},
          "reason": {"type": "string"},
          "role": {"type": "string"},
          "task_type": {"type": "string"},
          "operator_constraints": {"type": "object"},
          "artifact_types": {"type": "object"},
          "effect_profile": {"type": "object"},
          "proof_obligations": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "verifier_plans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["verifier_id", "verifier_type"],
        "properties": {
          "verifier_id": {"type": "string"},
          "verifier_type": {"type": "string"},
          "obligations_checked": {"type": "array", "items": {"type": "string"}},
          "configuration": {"type": "object"}
        }
      }
    },
    "plan_valid": {"type": "boolean"},
    "invalidation_reasons": {"type": "array", "items": {"type": "string"}},
    "access_path": {"type": ["string", "null"]},
    "quota": {"type": "object", "additionalProperties": true},
    "placement": {"type": "object", "additionalProperties": true},
    "policy": {"type": "object", "additionalProperties": true},
    "provenance": {
      "type": "object",
      "required": ["owner"],
      "properties": {"owner": {"type": "string"}}
    }
  }
}
