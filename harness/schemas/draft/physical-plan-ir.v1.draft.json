{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/draft/physical-plan-ir.v1.draft.json",
  "title": "Solar PhysicalPlanIR v1",
  "description": "PhysicalPlanIR is the fourth compile layer. It binds capsule plans to physical operators with trait/skill/MCP matching evidence, enforcer insertion, lease requirements, and evidence obligations. Links upstream to CapsulePlanIR via capsule_plan_id.",
  "type": "object",
  "required": ["schema_version", "physical_plan_id", "capsule_plan_id", "nodes"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "string", "const": "solar.physical_plan_ir.v1"},
    "physical_plan_id": {"type": "string", "minLength": 1},
    "capsule_plan_id": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "selected_operator_id"],
        "additionalProperties": true,
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "selected_operator_id": {"type": "string", "minLength": 1},
          "execution_candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["operator_id"],
              "additionalProperties": true,
              "properties": {
                "operator_id": {"type": "string"},
                "selected": {"type": "boolean"},
                "rejection_reason": {"type": "string"},
                "rank": {"type": "integer"}
              }
            }
          },
          "binding_evidence": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "traits_match": {"type": "boolean"},
              "skills_match": {"type": "boolean"},
              "mcp_match": {"type": "boolean"},
              "allowlist_pass": {"type": "boolean"},
              "denylist_pass": {"type": "boolean"},
              "evidence_score": {"type": "number"}
            }
          },
          "attached_enforcers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["enforcer_type", "insertion_point"],
              "additionalProperties": true,
              "properties": {
                "enforcer_type": {"type": "string"},
                "insertion_point": {"type": "string", "enum": ["before_execution", "during_execution", "after_execution"]},
                "enforcer_id": {"type": "string"},
                "policy_ref": {"type": "string"}
              }
            }
          },
          "lease_requirements": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "quota_type": {"type": "string"},
              "max_duration_seconds": {"type": "integer"},
              "mailbox_required": {"type": "boolean"},
              "runtime_type": {"type": "string"}
            }
          },
          "fallback_plan": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "alternate_operator_id": {"type": "string"},
              "local_recompile_route": {"type": "string"},
              "reason": {"type": "string"}
            }
          },
          "evidence_obligations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["obligation_type"],
              "additionalProperties": true,
              "properties": {
                "obligation_type": {"type": "string"},
                "artifact_path": {"type": "string"},
                "ledger_event": {"type": "string"},
                "verifier_outcome": {"type": "string"}
              }
            }
          }
        }
      },
      "minItems": 1
    },
    "provenance": {"$ref": "https://solar.local/schemas/draft/effect-ir.v1.draft.json#/definitions/provenance"}
  }
}
