{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/draft/intent-ir.v1.draft.json",
  "title": "Solar Intent IR v1",
  "description": "Intent IR captures user goals, task type, context, risk level, domain, and success criteria.",
  "type": "object",
  "required": ["schema_version", "intent_id", "goal", "task_type", "risk_level", "success_criteria"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "string", "const": "solar.intent_ir.v1"},
    "intent_id": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "task_type": {"type": "string", "minLength": 1},
    "context": {"type": "object", "additionalProperties": true},
    "risk_level": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "domain": {"type": "string"},
    "success_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "source_ref": {"type": "string"},
    "provenance": {"$ref": "https://solar.local/schemas/draft/effect-ir.v1.draft.json#/definitions/provenance"}
  }
}
