{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/draft/patch-ir.v1.draft.json",
  "title": "Solar Patch IR v1",
  "description": "Code change descriptor: repo, changed files, symbols, diff hash, tests, and scope tracking.",
  "type": "object",
  "required": ["ir_id", "ir_type", "schema_version"],
  "additionalProperties": true,
  "properties": {
    "ir_id": {"type": "string", "minLength": 1},
    "ir_type": {"type": "string", "const": "patch"},
    "schema_version": {"type": "string", "const": "1"},
    "node_id": {"type": "string"},
    "sprint_id": {"type": "string"},
    "repo": {"type": "string"},
    "branch": {"type": "string"},
    "base_ref": {"type": "string"},
    "changed_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "change_type"],
        "properties": {
          "path": {"type": "string"},
          "change_type": {"type": "string", "enum": ["create", "modify", "delete", "rename"]},
          "symbols_added": {"type": "array", "items": {"type": "string"}},
          "symbols_modified": {"type": "array", "items": {"type": "string"}},
          "symbols_removed": {"type": "array", "items": {"type": "string"}},
          "lines_added": {"type": "integer"},
          "lines_removed": {"type": "integer"},
          "diff_hash": {"type": "string"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_type", "path"],
        "properties": {
          "artifact_type": {"type": "string", "enum": ["file", "test_output", "benchmark", "handoff", "eval"]},
          "path": {"type": "string"},
          "description": {"type": "string"},
          "content_hash": {"type": "string"}
        }
      }
    },
    "overall_diff_hash": {"type": "string"},
    "tests_required": {"type": "array", "items": {"type": "string"}},
    "tests_run": {"type": "array", "items": {"type": "string"}},
    "tests_passed": {"type": "array", "items": {"type": "string"}},
    "scope_allowed": {"type": "array", "items": {"type": "string"}},
    "scope_actual": {"type": "array", "items": {"type": "string"}},
    "scope_violations": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object", "additionalProperties": true},
    "provenance": {
      "type": "object",
      "required": ["owner"],
      "properties": {"owner": {"type": "string"}}
    }
  }
}
