{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/draft/task-ir.v1.draft.json",
  "title": "Solar TaskIR v1",
  "description": "TaskIR is the first compile layer. It captures normalized user goal, success criteria, task types, domain, risk, constraints, and source trace from raw intent/PRD/requirement artifacts.",
  "type": "object",
  "required": ["schema_version", "task_ir_id", "goal", "success_criteria", "source_trace"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"type": "string", "const": "solar.task_ir.v1"},
    "task_ir_id": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "success_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "task_types": {"type": "array", "items": {"type": "string"}},
    "domain": {"type": "string"},
    "risk_level": {"type": "string", "enum": ["low", "medium", "high", "P0"]},
    "risk_reason": {"type": "string"},
    "constraints": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "non_goals": {"type": "array", "items": {"type": "string"}},
        "safety": {"type": "array", "items": {"type": "string"}},
        "compatibility": {"type": "array", "items": {"type": "string"}},
        "stop_rules": {"type": "array", "items": {"type": "string"}}
      }
    },
    "source_trace": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "raw_intent_ref": {"type": "string"},
        "prd_ref": {"type": "string"},
        "parent_epic_id": {"type": "string"},
        "requirement_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "provenance": {"$ref": "https://solar.local/schemas/draft/effect-ir.v1.draft.json#/definitions/provenance"}
  }
}
