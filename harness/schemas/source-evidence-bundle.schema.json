{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/source-evidence-bundle.schema.json",
  "title": "Solar Source Evidence Bundle",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "sprint_id",
    "created_at",
    "sources",
    "quality"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "solar.source_evidence_bundle.v1"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "sprint_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    },
    "quality": {
      "type": "object",
      "required": [
        "coverage",
        "confidence"
      ],
      "additionalProperties": true,
      "properties": {
        "coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "title",
          "url",
          "kind"
        ],
        "additionalProperties": true,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "excerpt": {
            "type": "string"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "claims_to_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "source_ids"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
