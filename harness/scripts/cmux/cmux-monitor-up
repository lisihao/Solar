#!/usr/bin/env python3
"""cmux-monitor-up: launch a cmux workspace from yaml config."""

import sys
import json
import subprocess
import argparse
from pathlib import Path

try:
    import yaml
except ImportError:
    print("ERROR: PyYAML not installed. Run: pip3 install pyyaml", file=sys.stderr)
    sys.exit(1)

SCRIPTS_DIR = Path(__file__).parent
RENDER_CMD = str(SCRIPTS_DIR / "render-cmux-workspace")
DEFAULT_CONFIG = Path(__file__).resolve().parents[2] / "config" / "cmux-workspace-sample.yaml"
CMUX_BIN_CANDIDATES = [
    "/Applications/cmux.app/Contents/Resources/bin/cmux",
    "/usr/local/bin/cmux",
    "/opt/homebrew/bin/cmux",
]


def find_cmux():
    for p in CMUX_BIN_CANDIDATES:
        if Path(p).exists():
            return p
    return None


def build_cmux_layout(tab: dict) -> dict:
    """Build a cmux JSON layout for one configured tab/workspace."""
    if not tab:
        return {}

    # cmux layout for a single tab's panes based on layout type
    def pane_node(cmd: str, title: str) -> dict:
        return {"pane": {"title": title, "surfaces": [{"type": "terminal", "command": cmd}]}}

    def quad_split(panes: list) -> dict:
        """2x2 equal split."""
        p = panes + [{"command": "echo empty", "title": "empty"}] * (4 - len(panes))
        return {
            "direction": "horizontal",
            "split": 0.5,
            "children": [
                {
                    "direction": "vertical",
                    "split": 0.5,
                    "children": [pane_node(p[0]["command"], p[0]["title"]),
                                 pane_node(p[2]["command"], p[2]["title"])],
                },
                {
                    "direction": "vertical",
                    "split": 0.5,
                    "children": [pane_node(p[1]["command"], p[1]["title"]),
                                 pane_node(p[3]["command"], p[3]["title"])],
                },
            ],
        }

    def split_layout(panes: list) -> dict:
        """1x2 horizontal split."""
        p = panes + [{"command": "echo empty", "title": "empty"}] * (2 - len(panes))
        return {
            "direction": "horizontal",
            "split": 0.5,
            "children": [pane_node(p[0]["command"], p[0]["title"]),
                         pane_node(p[1]["command"], p[1]["title"])],
        }

    def tri_layout(panes: list) -> dict:
        """top-two / bottom-one."""
        p = panes + [{"command": "echo empty", "title": "empty"}] * (3 - len(panes))
        return {
            "direction": "vertical",
            "split": 0.5,
            "children": [
                {
                    "direction": "horizontal",
                    "split": 0.5,
                    "children": [pane_node(p[0]["command"], p[0]["title"]),
                                 pane_node(p[1]["command"], p[1]["title"])],
                },
                pane_node(p[2]["command"], p[2]["title"]),
            ],
        }

    layout_builders = {
        "single": lambda p: pane_node(p[0]["command"], p[0]["title"]),
        "split":  split_layout,
        "tri":    tri_layout,
        "quad":   quad_split,
    }

    builder = layout_builders.get(tab["layout"], quad_split)
    return builder(tab["panes"])


def workspace_title(base_name: str, tab: dict, tab_count: int) -> str:
    """Map each config tab to a cmux workspace, which is cmux's tab-like unit."""
    if tab_count == 1:
        return base_name
    return f"{base_name}: {tab.get('title') or tab['id']}"


def main():
    parser = argparse.ArgumentParser(description="Launch cmux monitoring workspace")
    parser.add_argument("config", nargs="?", default=str(DEFAULT_CONFIG), help="Path to workspace.yaml")
    parser.add_argument("--dry-run", action="store_true", help="Print plan, don't launch")
    parser.add_argument("--no-select-first", action="store_true", help="Do not select the first launched workspace")
    args = parser.parse_args()

    config_path = Path(args.config).expanduser()
    if not config_path.exists():
        print(f"ERROR: config not found: {config_path}", file=sys.stderr)
        sys.exit(1)

    # Render plan via render-cmux-workspace
    result = subprocess.run(
        [sys.executable, RENDER_CMD, str(config_path), "--json"],
        capture_output=True, text=True
    )
    if result.returncode != 0:
        print(f"ERROR: render failed:\n{result.stderr}", file=sys.stderr)
        sys.exit(1)

    plan = json.loads(result.stdout)
    workspace_name = plan["workspace_name"]

    if args.dry_run:
        print(f"DRY-RUN: would launch workspace '{workspace_name}' with {len(plan['tabs'])} tab(s)")
        for tab in plan["tabs"]:
            print(f"  Workspace: {workspace_title(workspace_name, tab, len(plan['tabs']))} (layout={tab['layout']})")
            for p in tab["panes"]:
                print(f"    pane[{p['title']}]: {p['command']}")
        return

    cmux_bin = find_cmux()
    if not cmux_bin:
        print("ERROR: cmux binary not found. Check CMUX_BIN_CANDIDATES in script.", file=sys.stderr)
        sys.exit(1)

    print(f"Launching: {workspace_name}")
    launched_refs: list[str] = []
    for tab in plan["tabs"]:
        title = workspace_title(workspace_name, tab, len(plan["tabs"]))
        layout = build_cmux_layout(tab)
        cmd = [cmux_bin, "workspace", "create", "--name", title, "--layout", json.dumps(layout)]
        result = subprocess.run(cmd, check=True, capture_output=True, text=True)
        for token in (result.stdout or "").split():
            if token.startswith("workspace:"):
                launched_refs.append(token)
                break
        print(f"OK: workspace '{title}' launched")
    if launched_refs and not args.no_select_first:
        subprocess.run([cmux_bin, "workspace", "select", launched_refs[0]], check=False)
        print(f"OK: selected '{launched_refs[0]}'")
    print(f"OK: workspace group '{workspace_name}' launched with {len(plan['tabs'])} tab(s)")


if __name__ == "__main__":
    main()
