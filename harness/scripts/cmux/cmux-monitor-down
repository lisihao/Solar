#!/usr/bin/env python3
"""cmux-monitor-down: close the named cmux workspace without killing unrelated sessions."""

import sys
import subprocess
import argparse
import json
import re
from pathlib import Path

try:
    import yaml
except ImportError:
    print("ERROR: PyYAML not installed. Run: pip3 install pyyaml", file=sys.stderr)
    sys.exit(1)

SCRIPTS_DIR = Path(__file__).parent
DEFAULT_CONFIG = Path(__file__).resolve().parents[2] / "config" / "cmux-workspace-sample.yaml"
CMUX_BIN_CANDIDATES = [
    "/Applications/cmux.app/Contents/Resources/bin/cmux",
    "/usr/local/bin/cmux",
    "/opt/homebrew/bin/cmux",
]


def find_cmux():
    for p in CMUX_BIN_CANDIDATES:
        if Path(p).exists():
            return p
    return None


def get_workspace_names(config_path: Path) -> list[str]:
    with open(config_path) as f:
        cfg = yaml.safe_load(f)
    base_name = cfg.get("workspace_name", "cmux-workspace")
    tabs = cfg.get("tabs", [])
    if len(tabs) <= 1:
        return [base_name]
    return [f"{base_name}: {tab.get('title') or tab['id']}" for tab in tabs]


def list_workspace_refs(cmux_bin: str) -> dict[str, str]:
    """Return a best-effort mapping of workspace title to cmux ref."""
    json_result = subprocess.run(
        [cmux_bin, "workspace", "list", "--json"],
        capture_output=True,
        text=True,
    )
    if json_result.returncode == 0:
        try:
            payload = json.loads(json_result.stdout)
            refs = {}
            for item in payload.get("workspaces", []):
                title = str(item.get("title") or "").strip()
                ref = str(item.get("ref") or "").strip()
                if title and ref:
                    refs[title] = ref
            if refs:
                return refs
        except json.JSONDecodeError:
            pass

    result = subprocess.run(
        [cmux_bin, "workspace", "list"],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return {}

    refs: dict[str, str] = {}
    for raw_line in result.stdout.splitlines():
        line = raw_line.strip()
        line = line.removeprefix("*").strip()
        match = re.match(r"^(workspace:\d+)\s+(.*?)(?:\s+\[selected\])?$", line)
        if not match:
            continue
        ref, title = match.groups()
        refs[title.strip()] = ref
    return refs


def main():
    parser = argparse.ArgumentParser(description="Stop a cmux monitoring workspace")
    parser.add_argument("config", nargs="?", default=str(DEFAULT_CONFIG), help="Path to workspace.yaml (to resolve name)")
    parser.add_argument("--name", help="Workspace name (alternative to config file)")
    parser.add_argument("--dry-run", action="store_true", help="Print what would be done")
    args = parser.parse_args()

    if not args.config and not args.name:
        print("ERROR: provide either <config> or --name", file=sys.stderr)
        sys.exit(1)

    if args.name:
        workspace_names = [args.name]
    else:
        config_path = Path(args.config).expanduser()
        if not config_path.exists():
            print(f"ERROR: config not found: {config_path}", file=sys.stderr)
            sys.exit(1)
        workspace_names = get_workspace_names(config_path)

    if args.dry_run:
        for workspace_name in workspace_names:
            print(f"DRY-RUN: would close workspace '{workspace_name}'")
        return

    cmux_bin = find_cmux()
    if not cmux_bin:
        print("ERROR: cmux binary not found.", file=sys.stderr)
        sys.exit(1)

    closed = 0
    workspace_refs = list_workspace_refs(cmux_bin)
    for workspace_name in workspace_names:
        workspace_ref = workspace_refs.get(workspace_name, workspace_name)
        result = subprocess.run(
            [cmux_bin, "workspace", "close", workspace_ref],
            capture_output=True,
            text=True,
        )
        if result.returncode == 0:
            closed += 1
            print(f"OK: workspace '{workspace_name}' closed")
        else:
            reason = (result.stderr or result.stdout).strip()
            print(f"WARN: workspace '{workspace_name}' not closed: {reason}")

    if closed == 0:
        sys.exit(1)


if __name__ == "__main__":
    main()
