{
  "$schema": "https://solar.local/schemas/task-classification-taxonomy.v1.json",
  "schema_version": "solar.apo.task_classification_taxonomy.v1",
  "version": "1.0.0",
  "updated_at": "2026-06-05T14:00:00Z",
  "description": "APO task classification taxonomy for goal-driven workflow expansion and supply-chain planner artifacts.",
  "classifier": {
    "version": "v1",
    "selection_policy": "score_then_priority",
    "signal_weights": {
      "primary": 2,
      "secondary": 1,
      "negative": -3
    },
    "confidence_thresholds": {
      "high": 6,
      "medium": 3,
      "low": 1
    },
    "rejection_reasons": [
      "below_min_signal_score",
      "negative_signal_override",
      "outscored_by_primary",
      "unsupported_workflow_template"
    ]
  },
  "task_classes": {
    "PERFORMANCE_REGRESSION": {
      "id": "PERFORMANCE_REGRESSION",
      "priority": 100,
      "description": "A previously acceptable performance metric has degraded and needs root-cause analysis plus benchmark verification.",
      "primary_signals": [
        "slower",
        "degraded",
        "latency",
        "throughput",
        "ttft",
        "p50",
        "p99",
        "baseline"
      ],
      "secondary_signals": [
        "benchmark",
        "performance",
        "memory",
        "mlx",
        "flashmlx",
        "regression"
      ],
      "negative_signals": [
        "frontend",
        "ui",
        "visual",
        "css"
      ],
      "min_signal_score": 2,
      "default_workflow": "performance_debug_workflow",
      "required_workflow_stages": [
        "ScanContext",
        "DebugRCA",
        "DesignSolution",
        "ImplementPatch",
        "RunBenchmark",
        "ReviewPatch",
        "VerifyEvidence"
      ],
      "preferred_capsule_tags": [
        "performance",
        "debug",
        "benchmark"
      ],
      "required_artifact_sections": [
        "task_classification",
        "logical_workflow",
        "skill_plan",
        "mcp_plan",
        "capsule_plan",
        "physical_plan",
        "evidence_refs"
      ]
    },
    "PERFORMANCE_KERNEL_DEBUG": {
      "id": "PERFORMANCE_KERNEL_DEBUG",
      "priority": 110,
      "description": "A hardware accelerated kernel or low-level ML performance path has unexpected throughput, latency, or memory behavior.",
      "primary_signals": [
        "gather_qmm",
        "kernel",
        "cuda",
        "metal",
        "gpu",
        "npu",
        "flashmlx",
        "mlx",
        "attention",
        "fused"
      ],
      "secondary_signals": [
        "throughput",
        "memory",
        "benchmark",
        "profile",
        "trace"
      ],
      "negative_signals": [
        "frontend",
        "ui",
        "api",
        "rest"
      ],
      "min_signal_score": 2,
      "default_workflow": "performance_debug_workflow",
      "required_workflow_stages": [
        "ScanContext",
        "DebugRCA",
        "DesignSolution",
        "ImplementPatch",
        "RunBenchmark",
        "ReviewPatch",
        "VerifyEvidence"
      ],
      "preferred_capsule_tags": [
        "performance",
        "debug",
        "ai_infra",
        "mlx"
      ],
      "required_artifact_sections": [
        "task_classification",
        "logical_workflow",
        "skill_plan",
        "mcp_plan",
        "capsule_plan",
        "physical_plan",
        "evidence_refs"
      ]
    },
    "SOFT_HW_OPT": {
      "id": "SOFT_HW_OPT",
      "priority": 90,
      "description": "Software and hardware co-optimization through tuning, layout, precision, scheduling, or memory strategy.",
      "primary_signals": [
        "quantization",
        "batch",
        "precision",
        "fp16",
        "int8",
        "bfloat16",
        "tiling",
        "layout",
        "paged_attention"
      ],
      "secondary_signals": [
        "optimize",
        "throughput",
        "memory",
        "mlx",
        "gpu",
        "npu"
      ],
      "negative_signals": [
        "regression",
        "bug",
        "crash",
        "error"
      ],
      "min_signal_score": 2,
      "default_workflow": "design_and_optimize_workflow",
      "required_workflow_stages": [
        "ScanContext",
        "DesignSolution",
        "ImplementPatch",
        "RunBenchmark",
        "VerifyEvidence"
      ],
      "preferred_capsule_tags": [
        "performance",
        "ai_infra"
      ],
      "required_artifact_sections": [
        "task_classification",
        "logical_workflow",
        "skill_plan",
        "mcp_plan",
        "capsule_plan",
        "physical_plan",
        "evidence_refs"
      ]
    },
    "CODE_IMPL_REQUIRED": {
      "id": "CODE_IMPL_REQUIRED",
      "priority": 70,
      "description": "A product, feature, module, API, or integration must be implemented from requirements.",
      "primary_signals": [
        "implement",
        "feature",
        "add",
        "create",
        "write",
        "build",
        "develop"
      ],
      "secondary_signals": [
        "spec",
        "requirement",
        "prd",
        "api",
        "module",
        "function"
      ],
      "negative_signals": [
        "benchmark",
        "profile",
        "regression"
      ],
      "min_signal_score": 2,
      "default_workflow": "implementation_workflow",
      "required_workflow_stages": [
        "ScanContext",
        "DesignSolution",
        "ImplementPatch",
        "ReviewPatch",
        "VerifyEvidence"
      ],
      "preferred_capsule_tags": [
        "implementation",
        "builder"
      ],
      "required_artifact_sections": [
        "task_classification",
        "logical_workflow",
        "skill_plan",
        "mcp_plan",
        "capsule_plan",
        "physical_plan",
        "evidence_refs"
      ]
    },
    "FAST_PROTOTYPE": {
      "id": "FAST_PROTOTYPE",
      "priority": 50,
      "description": "A fast proof of concept or spike intended to validate feasibility before a production contract.",
      "primary_signals": [
        "prototype",
        "poc",
        "proof-of-concept",
        "quick",
        "draft",
        "spike"
      ],
      "secondary_signals": [
        "try",
        "explore",
        "experiment",
        "validate"
      ],
      "negative_signals": [
        "production",
        "deploy",
        "release",
        "stable"
      ],
      "min_signal_score": 1,
      "default_workflow": "prototype_workflow",
      "required_workflow_stages": [
        "ScanContext",
        "ImplementPatch",
        "VerifyEvidence"
      ],
      "preferred_capsule_tags": [
        "builder",
        "implementation"
      ],
      "required_artifact_sections": [
        "task_classification",
        "logical_workflow",
        "skill_plan",
        "mcp_plan",
        "capsule_plan",
        "physical_plan",
        "evidence_refs"
      ]
    }
  },
  "planner_artifact_contract": {
    "required_sections": [
      "task_classification",
      "logical_workflow",
      "skill_plan",
      "mcp_plan",
      "capsule_plan",
      "physical_plan",
      "evidence_refs"
    ],
    "explainability_required": true,
    "selection_rationale_required": true,
    "rejection_rationale_required": true,
    "fallback_flags_required": true
  }
}
