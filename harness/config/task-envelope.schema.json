{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar.local/schemas/task-envelope.v1.json",
  "title": "Solar Task Envelope v1",
  "type": "object",
  "required": [
    "envelope_version",
    "task_id",
    "sprint_id",
    "node_id",
    "actor_id",
    "payload",
    "submitted_at",
    "ttl_sec",
    "priority"
  ],
  "additionalProperties": false,
  "properties": {
    "envelope_version": {
      "const": "solar.task_envelope.v1",
      "type": "string"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "sprint_id": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "actor_id": {
      "type": "string",
      "minLength": 1
    },
    "operator_id": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "dispatch",
            "wake",
            "eval",
            "abort"
          ]
        },
        "contract_path": {
          "type": "string",
          "minLength": 1
        },
        "task_graph_path": {
          "type": "string",
          "minLength": 1
        },
        "node_goal": {
          "type": "string",
          "minLength": 1
        },
        "write_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "read_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dispatch_md_path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "ttl_sec": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "priority": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2"
      ]
    },
    "preemptible": {
      "type": "boolean"
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dispatch_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_task_id": {
          "type": "string",
          "minLength": 1
        },
        "caused_by_event_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "ResultEnvelope": {
      "title": "Solar Task Result Envelope v1",
      "type": "object",
      "required": [
        "envelope_version",
        "task_id",
        "actor_id",
        "status",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "envelope_version": {
          "const": "solar.result_envelope.v1",
          "type": "string"
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9._-]+$"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed",
            "timed_out",
            "rejected"
          ]
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "evidence": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "result_path": {
              "type": "string",
              "minLength": 1
            },
            "logs_path": {
              "type": "string",
              "minLength": 1
            },
            "state_path": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
