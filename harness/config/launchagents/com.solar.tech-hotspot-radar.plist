<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.solar.tech-hotspot-radar</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/lisihao/Solar/harness/scripts/run_tech_hotspot_radar.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>RUN_GENESISPOD_SYNC</key>
    <string>1</string>
    <key>ALLOW_PARTIAL_SUCCESS</key>
    <string>1</string>
    <key>SOCIAL_BACKEND</key>
    <string>rss</string>
    <key>SOLAR_SOCIAL_BROWSER_BACKEND_DISABLE</key>
    <string>1</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/lisihao/.solar/harness/run/tech-hotspot-radar.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/lisihao/.solar/harness/run/tech-hotspot-radar.err.log</string>
</dict>
</plist>
